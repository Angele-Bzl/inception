<file path="srcs/requirements/mariadb/tools/init.sh">
#!/bin/sh

set -e

mkdir -p /var/lib/mysql && chown -R mysql:mysql /var/lib/mysql
mkdir -p /run/mysqld && chown -R mysql:mysql /run/mysqld

echo "before if"

if [ ! -d "/var/lib/mysql/mysql" ]; then
    echo "Initializing fresh MariaDB..."

    mariadb-install-db --user=mysql --datadir=/var/lib/mysql

    mariadbd --user=mysql --datadir=/var/lib/mysql --skip-networking &
    MARIADB_PID=$!

    until mariadb-admin ping --silent 2>/dev/null; do
        echo "Waiting for MariaDB..."
        sleep 1
    done

    mariadb -u root << EOF
ALTER USER 'root'@'localhost' IDENTIFIED VIA mysql_native_password;
SET PASSWORD = PASSWORD('${MYSQL_ROOT_PASSWORD}');
CREATE DATABASE IF NOT EXISTS ${MYSQL_DATABASE};
CREATE USER IF NOT EXISTS '${MYSQL_USER_ADMIN}'@'%' IDENTIFIED BY '${MYSQL_PASSWORD_ADMIN}';
GRANT ALL PRIVILEGES ON ${MYSQL_DATABASE}.* TO '${MYSQL_USER_ADMIN}'@'%';
FLUSH PRIVILEGES;
EOF

    mariadb-admin -u root -p"${MYSQL_ROOT_PASSWORD}" shutdown
    wait $MARIADB_PID

    echo "MariaDB initialized successfully!"
fi
echo "after if"

exec mariadbd --user=mysql --datadir=/var/lib/mysql \
    --bind-address=0.0.0.0
    # --console
</file>

<file path="srcs/docker-compose.yml">
# A docker-network that establishes the connection between your containers
# Your containers have to restart in case of a crash.
# version: "3" #docker version

services: #containers images to use
  nginx: 
    container_name: nginx
    build:
      context: ./requirements
      dockerfile: nginx/Dockerfile
    ports: 
      - "443:443" #port mapping to access from my machine host:container
    restart: always
    depends_on:   
      wordpress:
        condition: service_healthy
        restart: true
    volumes:
      - wordpress_data:/var/www/html
    networks:
      - inception

  mariadb:
    container_name: mariadb
    build:
      context: ./requirements
      dockerfile: mariadb/Dockerfile
    volumes:
      # - wordpress_data:/var/www/html
      - mariadb_data:/var/lib/mysql
    healthcheck:
          test: ["CMD", "mariadb-admin", "ping", "-h", "localhost", "--silent"] # warning loop because no password
          interval: 5s
          timeout: 5s
          retries: 5
    restart: always
    networks:
      - inception
    environment:
      - MYSQL_ROOT_PASSWORD=${MYSQL_ROOT_PASSWORD}
      - MYSQL_DATABASE=${MYSQL_DATABASE}
      - MYSQL_USER_ADMIN=${MYSQL_USER_ADMIN}
      - MYSQL_PASSWORD_ADMIN=${MYSQL_PASSWORD_ADMIN}
    
  wordpress:
    container_name: wordpress
    build:
      context: ./requirements
      dockerfile: wordpress/Dockerfile
    depends_on:   
      mariadb:
        condition: service_healthy
        restart: true
    healthcheck:
      test: ["CMD", "nc", "-z", "localhost", "9000"]
      interval: 5s
      timeout: 5s
      retries: 5
    volumes:
      # - "/home/abarzila/data" #mapping to store and not disappear
      - wordpress_data:/var/www/html
    restart: always
    networks:
      - inception
    environment:
      - MYSQL_ROOT_PASSWORD=${MYSQL_ROOT_PASSWORD}
      - MYSQL_DATABASE=${MYSQL_DATABASE}
      - MYSQL_USER_ADMIN=${MYSQL_USER_ADMIN}
      - MYSQL_PASSWORD_ADMIN=${MYSQL_PASSWORD_ADMIN}
      - WP_URL=${WP_URL}
      - WP_ADMIN_USER=${WP_ADMIN_USER}
      - WP_ADMIN_PASSWORD=${WP_ADMIN_PASSWORD}
      - WP_ADMIN_EMAIL=${WP_ADMIN_EMAIL}
      - WP_USER=${WP_USER}
      - WP_USER_EMAIL=${WP_USER_EMAIL}
      - WP_USER_PASSWORD=${WP_USER_PASSWORD}



networks:
  inception:
    driver: bridge
    ipam:
      config:
        - subnet: "172.20.0.0/16"

volumes:
  wordpress_data: #check the infos ?
    name: wordpress
    driver: local
    driver_opts:
      type: none
      o: bind
      device: /home/abarzila/data/wordpress

  mariadb_data: #check the infos ?
    name: mariadb
    driver: local
    driver_opts:
      type: none
      o: bind
      device: /home/abarzila/data/mariadb
</file>

